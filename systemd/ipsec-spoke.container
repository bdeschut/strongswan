[Unit]
Description=StrongSwan IPsec with QPC to Palo Alto Hub
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/pq-strongswan:latest
ContainerName=ipsec-vpn


# Automated Startup: Launch charon, wait for socket, load configs, and keep charon as foreground PID
Entrypoint=/bin/sh
Exec=-c "/usr/local/libexec/ipsec/charon & pid=$!; while [ ! -S /var/run/charon.vici ]; do sleep 0.2; done; swanctl --load-all; wait $pid"

# Host networking and raw net privileges are mandatory for host routing
Network=host
AddCapability=CAP_NET_ADMIN CAP_NET_RAW

# Mount configuration and secrets
Volume=/opt/strongswan/strongswan.conf:/usr/local/etc/strongswan.conf:ro,Z
Volume=/opt/strongswan/swanctl.conf:/usr/local/etc/swanctl/swanctl.conf:ro,Z
#Volume=/opt/strongswan/strongswan.conf:/etc/strongswan/strongswan.conf:ro,Z
#Volume=/opt/strongswan/swanctl.conf:/etc/strongswan/swanctl.conf:ro,Z
Volume=/lib/modules:/lib/modules:ro

# Healthcheck: Verify that the Palo Alto tunnel interface IP is reachable
# If ping fails 5 times in a row (5 min total), Podman marks container unhealthy
#HealthCmd=ping -I ipsec0 -c 1 -W 3 10.9.0.17 || exit 1
#HealthInterval=60s
#HealthRetries=5
#HealthTimeout=5s
#HealthOnFailure=restart

[Service]
# Clean up any stale interface if left behind
ExecStartPre=-/usr/sbin/ip link del ipsec0
# Create the xfrm interface bound to ID 42
ExecStartPre=/usr/sbin/ip link add ipsec0 type xfrm if_id 42
# Assign tunnel IP and bring up
ExecStartPre=/usr/sbin/ip addr add 10.9.0.18/30 peer 10.9.0.17 dev ipsec0
ExecStartPre=/usr/sbin/ip link set ipsec0 up
# Route home subnets across the tunnel (replace 10.0.0.0/16 with your home subnets)
ExecStartPre=-/usr/sbin/ip route replace 10.0.0.0/16 dev ipsec0
# Clean up interface when stopped
ExecStopPost=-/usr/sbin/ip link del ipsec0
Restart=always
RestartSec=15s

[Install]
WantedBy=multi-user.target