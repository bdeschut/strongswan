[Unit]
Description=StrongSwan IPsec with QPC to Palo Alto Hub
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/bdeschut/pq-strongswan:latest
AutoUpdate=registry
ContainerName=ipsec-vpn

# Host networking and raw net privileges are mandatory for host routing
Network=host
AddCapability=CAP_NET_ADMIN CAP_NET_RAW

# Mount configuration and secrets
Volume=/opt/strongswan/strongswan.conf:/etc/swanctl/conf.d/strongswan.conf:ro,Z
Volume=/lib/modules:/lib/modules:ro

# Healthcheck: Verify that the Palo Alto tunnel interface IP is reachable
# If ping fails 5 times in a row (5 min total), Podman marks container unhealthy
#HealthCmd=ping -I ipsec0 -c 1 -W 3 changeme_IP_HUB || exit 1
#HealthInterval=60s
#HealthRetries=5
#HealthTimeout=5s
#HealthOnFailure=restart

[Service]
# Clean up any stale interface if left behind
ExecStartPre=-/usr/sbin/ip link del ipsec0
# Create the xfrm interface bound to ID 42
ExecStartPre=/usr/sbin/ip link add ipsec0 type xfrm if_id 42
# Assign tunnel IP and bring up
ExecStartPre=/usr/sbin/ip addr add changeme_IP_SPOKE/30 peer changeme_IP_HUB dev ipsec0
ExecStartPre=/usr/sbin/ip link set ipsec0 up
# Route home subnets across the tunnel (replace 10.0.0.0/16 with your home subnets)
ExecStartPre=-/usr/sbin/ip route replace changeme_HUB_NET dev ipsec0
# Clean up interface when stopped
ExecStopPost=-/usr/sbin/ip link del ipsec0
Restart=always
RestartSec=15s

[Install]
WantedBy=multi-user.target