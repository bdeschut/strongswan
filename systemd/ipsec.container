# /etc/containers/systemd/ipsec.container
[Unit]
Description=StrongSwan IPsec with QPC to Palo Alto Hub
After=network-online.target ipsec-interface.service
Wants=network-online.target
Requires=ipsec-interface.service

[Container]
Image=ghcr.io/bdeschut/pq-strongswan:latest
AutoUpdate=registry
ContainerName=ipsec-vpn

# Host networking and raw net privileges are mandatory for host routing
Network=host
AddCapability=CAP_NET_ADMIN CAP_NET_RAW

# Mount daemon config, swanctl config, and kernel modules cleanly
Volume=/opt/strongswan/strongswan.conf:/etc/strongswan.conf:ro,Z
Volume=/opt/strongswan/swanctl.conf:/etc/swanctl/swanctl.conf:ro,Z
Volume=/lib/modules:/lib/modules:ro

# Let strongSwan handle link failure: StrongSwan's dpd_action = restart automatically sends keepalives and attempts background reconnection without killing the daemon process.
# Container healthcheck monitors the VICI socket: The healthcheck only verifies that Charon is responsive and has not deadlocked or crashed.
# We do need ping to have an "always-on" tunnel though.
HealthCmd=/bin/sh -c 'ping -I ipsec0 -c 1 -W 2 changeme_VPNIP_HUB >/dev/null 2>&1 || true; swanctl --stats >/dev/null 2>&1 || exit 1'
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=15s
HealthOnFailure=restart

[Service]
Restart=always
RestartSec=15s

[Install]
WantedBy=multi-user.target
