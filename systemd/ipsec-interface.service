# /etc/systemd/system/ipsec-interface.service
[Unit]
Description=Setup XFRM interface and routes for IPsec VPN
After=network-online.target
Wants=network-online.target
Before=ipsec.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Clean up stale devices if any exist
ExecStartPre=-/usr/sbin/ip link del ipsec0

# Create and configure the XFRM interface
ExecStart=/usr/sbin/ip link add ipsec0 type xfrm if_id 42
ExecStart=/usr/sbin/ip addr add changeme_VPNIP_SPOKE/30 peer changeme_VPNIP_HUB dev ipsec0
# physical eth0/wlan0 uplink is 1500
# An IPsec ESP packet wrapping AES-256-GCM adds 62 to 78 bytes of tunnel overhead
# Fix: Lower the interface MTU in your systemd interface unit
ExecStart=/usr/sbin/ip link set ipsec0 mtu 1400 up

# Teardown interface on service stop
ExecStop=-/usr/sbin/ip link del ipsec0

[Install]
WantedBy=multi-user.target